# Frontend (Next.js)
# Required for Supabase anon auth + data (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required SERVER-SIDE only (never exposed to the browser). Used by
# /api/* routes to perform authenticated mutations on the user's behalf.
# Without this, the demo trigger and approve/reject endpoints will 500.
SUPABASE_SERVICE_ROLE_KEY=

# WebSocket endpoint for live disruption events. Must be wss:// in
# production. ws://localhost:* is allowed for dev.
NEXT_PUBLIC_WS_URL=wss://api.r3flex.io/ws/disruptions
